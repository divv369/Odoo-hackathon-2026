<% layout("/layouts/boilerplate") %>

<div class="row mt-3">
    <div class="col-10 offset-1">
        <h3>Admin Panel</h3>

        <div class="row mb-4">
            <div class="col-md-3">
                <div class="card text-center"><div class="card-body"><h2><%= totalUsers %></h2><p class="text-muted mb-0">Total Users</p></div></div>
            </div>
            <div class="col-md-3">
                <div class="card text-center"><div class="card-body"><h2><%= totalTrips %></h2><p class="text-muted mb-0">Total Trips</p></div></div>
            </div>
            <div class="col-md-3">
                <a href="/admin/users" class="text-decoration-none">
                    <div class="card text-center"><div class="card-body"><i class="fa-solid fa-users"></i><p class="mb-0">Manage Users</p></div></div>
                </a>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                <h5>Popular Cities</h5>
                <canvas id="citiesChart"></canvas>
            </div>
            <div class="col-md-6">
                <h5>Popular Activities</h5>
                <canvas id="activitiesChart"></canvas>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    const citiesData = <%- JSON.stringify(popularCities) %>;
    const activitiesData = <%- JSON.stringify(popularActivities) %>;

    new Chart(document.getElementById("citiesChart"), {
        type: "bar",
        data: {
            labels: citiesData.map(c => c._id || "Unknown"),
            datasets: [{ label: "Trips", data: citiesData.map(c => c.count), backgroundColor: "#fe424d" }],
        },
    });

    new Chart(document.getElementById("activitiesChart"), {
        type: "pie",
        data: {
            labels: activitiesData.map(a => a._id || "Unknown"),
            datasets: [{ data: activitiesData.map(a => a.count) }],
        },
    });
</script>
