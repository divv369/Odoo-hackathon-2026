<% layout("/layouts/boilerplate") %>

<div class="row mt-3">
    <div class="col-10 offset-1">
        <h3>My Trips</h3>

        <% ["ongoing", "upcoming", "completed"].forEach(function(status) { %>
            <h5 class="mt-4 text-capitalize"><%= status %></h5>
            <% if(grouped[status].length === 0) { %>
                <p class="text-muted">No <%= status %> trips.</p>
            <% } %>
            <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1">
                <% grouped[status].forEach(function(trip) { %>
                    <a href="/trips/<%= trip._id %>" class="trip-link">
                        <div class="card col trip-card mb-3">
                            <img src="<%= trip.image.url %>" class="card-img-top" style="height: 12rem; object-fit: cover;" alt="trip_image"/>
                            <div class="card-body">
                                <p class="card-text">
                                    <b><%= trip.title %></b><br/>
                                    <small><%= trip.place %></small><br/>
                                    <small>
                                        <%= trip.startDate ? trip.startDate.toDateString() : "" %>
                                        &rarr;
                                        <%= trip.endDate ? trip.endDate.toDateString() : "" %>
                                    </small>
                                </p>
                            </div>
                        </div>
                    </a>
                <% }) %>
            </div>
        <% }) %>

        <a href="/trips/new" class="btn btn-dark mt-3">+ Plan a Trip</a>
    </div>
</div>
