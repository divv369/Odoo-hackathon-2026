<% layout("/layouts/boilerplate") %>

<div class="row mt-3">
    <div class="col-8 offset-2">
        <h3><%= trip.title %></h3>
        <p class="text-muted"><%= trip.place %><% if(trip.country) { %>, <%= trip.country %><% } %></p>
    </div>

    <div class="card col-8 offset-2 mb-3">
        <img src="<%= trip.image.url %>" class="card-img-top" style="max-height: 300px; object-fit: cover;" alt="trip_image" />
        <div class="card-body">
            <p class="card-text">Planned by <i><%= trip.owner ? trip.owner.username : "Unknown" %></i></p>
            <p class="card-text"><%= trip.description %></p>
            <p class="card-text">
                <%= trip.startDate ? trip.startDate.toDateString() : "TBD" %>
                &rarr;
                <%= trip.endDate ? trip.endDate.toDateString() : "TBD" %>
            </p>
            <p class="card-text"><strong>Total Trip Budget: &#8377; <%= totalBudget.toLocaleString("en-IN") %></strong></p>
        </div>
    </div>

    <div class="col-8 offset-2">
        <% if(currUser && trip.owner._id.equals(currUser._id)) { %>
            <a href="/trips/<%= trip._id %>/edit" class="btn btn-dark btn-sm">Build / Edit Itinerary</a>
        <% } %>
    </div>

    <div class="col-8 offset-2 mt-4">
        <h4>Itinerary for <%= trip.place %></h4>

        <% let dayNums = Object.keys(dayGroups).sort((a,b) => a - b); %>
        <% if(dayNums.length === 0) { %>
            <p class="text-muted">No activities added yet. Head to "Build / Edit Itinerary" to add some.</p>
        <% } %>

        <% dayNums.forEach(function(dayNum) { %>
            <h5 class="mt-3">Day <%= dayNum %></h5>
            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th>Physical Activity</th>
                        <th>Expense</th>
                    </tr>
                </thead>
                <tbody>
                    <% dayGroups[dayNum].forEach(function(activity) { %>
                        <tr>
                            <td><%= activity.name %></td>
                            <td>&#8377; <%= activity.expense %></td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        <% }) %>
    </div>

    <div class="col-8 offset-2 mt-3">
        <% if(currUser && trip.owner._id.equals(currUser._id)) { %>
        <a href="/trips/<%= trip._id %>/edit" class="btn btn-dark col-1 edit-btn">Edit</a>
        <form method="POST" action="/trips/<%= trip._id %>?_method=DELETE" class="d-inline">
            <button class="btn btn-dark ms-2">Delete</button>
        </form>
        <% } %>
    </div>

    <div class="col-8 offset-2 mt-4">
        <hr>
        <h4>Leave a Review</h4>
        <form action="/trips/<%= trip.id %>/reviews" method="post" novalidate class="needs-validation">
            <div class="mb-3 mt-3">
                <label class="form-label">Rating</label>
                <fieldset class="starability-slot">
                    <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
                    <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                    <label for="first-rate1" title="Terrible">1 star</label>
                    <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                    <label for="first-rate2" title="Not good">2 stars</label>
                    <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                    <label for="first-rate3" title="Average">3 stars</label>
                    <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                    <label for="first-rate4" title="Very good">4 stars</label>
                    <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                    <label for="first-rate5" title="Amazing">5 stars</label>
                </fieldset>
            </div>
            <div class="mb-3 mt-3">
                <label for="comment" class="form-label">Comments</label>
                <textarea name="review[comment]" id="comment" cols="30" rows="5" class="form-control" required></textarea>
            </div>
            <button class="btn btn-outline-dark">Submit</button>
        </form>
        <p class="text-muted mt-2">Reviews left here also show up in the <a href="/community">Community tab</a>.</p>
    </div>

    <div class="col-8 offset-2 mt-3">
        <h3>Where you'll be</h3>
        <div id="map" style="width: 100%; height: 400px;"></div>
    </div>
</div>

<script>
    const mapToken = "<%= process.env.MAP_TOKEN %>";
    const trip = {
        title: "<%= trip.title %>",
        geometry: <%- JSON.stringify(trip.geometry) %>
    };
</script>
<script src="/js/map.js"></script>
