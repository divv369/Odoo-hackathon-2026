<% layout("/layouts/boilerplate") %>

<div class="row mt-3">
    <div class="col-8 offset-2">
        <h3>Community</h3>
        <p class="text-muted">
            See what other travelers experienced — every review shared across
            every trip, newest first.
        </p>

        <% if(currUser) { %>
        <div class="card mb-4">
            <div class="card-body">
                <h5 class="card-title">Share your experience</h5>
                <form action="/community" method="POST" novalidate class="needs-validation">
                    <div class="mb-2">
                        <label class="form-label">Rating</label>
                        <select name="review[rating]" class="form-select" required>
                            <option value="5">5 - Amazing</option>
                            <option value="4">4 - Very good</option>
                            <option value="3">3 - Average</option>
                            <option value="2">2 - Not good</option>
                            <option value="1">1 - Terrible</option>
                        </select>
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Your experience</label>
                        <textarea name="review[comment]" class="form-control" rows="3" required></textarea>
                    </div>
                    <button class="btn btn-dark">Post</button>
                </form>
            </div>
        </div>
        <% } %>

        <% posts.forEach(function(post) { %>
            <div class="card mb-3">
                <div class="card-body">
                    <h5 class="card-title">
                        @ <%= post.author ? post.author.username : "Anonymous" %>
                        <% if(post.tripId) { %>
                            <small class="text-muted"> on <a href="/trips/<%= post.tripId._id %>"><%= post.tripId.title %></a></small>
                        <% } %>
                    </h5>
                    <p class="card-text">Rating: <%= post.rating %>/5</p>
                    <p class="card-text"><%= post.comment %></p>
                    <small class="text-muted"><%= post.createdAt.toDateString() %></small>
                </div>
            </div>
        <% }) %>

        <% if(posts.length === 0) { %>
            <p class="text-muted">No community posts yet — be the first to share!</p>
        <% } %>
    </div>
</div>
